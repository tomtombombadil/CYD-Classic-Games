// The game list. One line per game, in picker order within its category.
// Read by src/games/registry.cpp (C++) and tools/make_site.py (web page),
// so nothing else hard-codes the list.
//
// GAME(id, "Title", Category, modes, "one-line description")
//   id        folder src/games/<id>/, save /games/<id>.bin, stats <id>.csv;
//             the game defines `extern const games::GameOps <id>_ops`
//             and its How To Play pages `games::Help <id>_help`
//   Category  Puzzles, Strategy, Cards, Word, Dice or Other
//   modes     kSolo, kVsComputer, kPassAndPlay, kNetwork (or-ed)
//
// Keep each entry on one line (make_site.py reads it with a regex).

GAME(sudoku, "Sudoku", Puzzles, kSolo, "9x9 with notes and hints; four levels graded by solving technique")
GAME(lightswitch, "Light Switch", Puzzles, kSolo, "Flip a light and its neighbours until every light is off; par shows the fewest presses")
GAME(sliding, "Sliding Tiles", Puzzles, kSolo, "The 15-Puzzle, plus 3x3 and 5x5: slide the tiles back into order")
GAME(twenty48, "2048", Puzzles, kSolo, "Tap toward a side to slide every tile that way; merge equal tiles to reach 2048")
GAME(minesweeper, "Minesweeper", Puzzles, kSolo, "Clear the field without hitting a mine; every board solvable by logic, no guessing")
GAME(mastercyd, "MasterCYD", Puzzles, kSolo, "Crack the hidden color code in 10 guesses; dots and rings tell you how close you are")
GAME(pegs, "Peg Solitaire", Puzzles, kSolo, "Jump pegs over each other until only one is left; triangle, English and European boards")
GAME(memory, "Memory Match", Puzzles, kSolo, "Turn tiles two at a time and find every matching pair in as few turns as you can")
GAME(nonogram, "Nonograms", Puzzles, kSolo, "Paint by numbers: fill the grid so every row and column matches its clue")
GAME(fourconnect, "FourConnect", Strategy, kVsComputer | kPassAndPlay | kNetwork, "Drop discs to line up four; three computer levels or pass-and-play")
GAME(tictactoe, "Tic-Tac-Toe", Strategy, kVsComputer | kPassAndPlay | kNetwork, "Three in a row; the Hard computer never loses")
GAME(reversi, "Reversi", Strategy, kVsComputer | kPassAndPlay | kNetwork, "Outflank and flip; legal moves shown as dots; Hard plays the endgame perfectly")
GAME(checkers, "Checkers", Strategy, kVsComputer | kPassAndPlay | kNetwork, "American checkers: compulsory jumps, multi-jumps tapped step by step, kings")
GAME(chess, "Chess", Strategy, kVsComputer | kPassAndPlay | kNetwork, "Full rules; tap a piece, then its square; long-press any piece to see its moves")
GAME(solitaire, "Solitaire", Cards, kSolo, "Klondike: build the four suits up from Ace to King; draw 1 or 3, Standard or Vegas scoring")
GAME(spider, "Spider", Cards, kSolo, "Two decks, ten columns: build King-to-Ace runs in one suit; 1, 2 or 4 suits")
GAME(pyramid, "Pyramid", Cards, kSolo, "Pair up cards that add to 13 and take the pyramid apart; Kings go alone")
GAME(golf, "Golf", Cards, kSolo, "Clear seven columns onto the waste, one rank up or down at a time")
GAME(cyddle, "CYD-dle", Word, kSolo, "Guess the five-letter word in six tries; green, gold and grey hints")
GAME(yahtcyd, "Yaht-CYD", Dice, kSolo, "Five dice, three rolls, thirteen boxes; chase the upper bonus and Yaht-CYDs")
